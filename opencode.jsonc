{
  "$schema": "https://opencode.ai/config.json",

  // Start with models whose OpenCode IDs explicitly identify them as free.
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/north-mini-code-free",
  "default_agent": "build",

  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests"
      }
    }
  },

  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "sudo": "ask",
      "sudo *": "ask",
      "dnf": "ask",
      "dnf *": "ask",
      "flatpak install*": "ask",
      "npm install -g*": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git branch -D*": "ask",
      "git push*": "ask",
      "gh pr create*": "ask",
      "gh release create*": "ask",
      "npm publish*": "ask"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "bin/**",
      "obj/**",
      ".next/**",
      ".git/**"
    ]
  }
}
